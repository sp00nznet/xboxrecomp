# Embed files as C arrays, at build time, with no tool beyond CMake.
#   cmake -DOUT=<file.c> -DNAMES="a|b" -DFILES="<path a>|<path b>" -P embed_files.cmake
# Each file becomes
#   const unsigned char <name>[] = { ... };
#   const unsigned long <name>_len = <bytes>;
# The overlay's fonts use it (src/kernel/CMakeLists.txt): the TTFs stay
# unmodified in third_party/ and the binary carries them as they are.
# "|" separates the items, since a ";" splits a custom command's argument.
string(REPLACE "|" ";" NAMES "${NAMES}")
string(REPLACE "|" ";" FILES "${FILES}")
list(LENGTH NAMES _n)
list(LENGTH FILES _nf)
if(NOT _n EQUAL _nf)
    message(FATAL_ERROR "embed_files: ${_n} names for ${_nf} files")
endif()
set(_out "/* Generated by cmake/embed_files.cmake. Do not edit. */\n")
math(EXPR _last "${_n} - 1")
foreach(_i RANGE ${_last})
    list(GET NAMES ${_i} _name)
    list(GET FILES ${_i} _file)
    file(READ "${_file}" _hex HEX)
    string(LENGTH "${_hex}" _hl)
    math(EXPR _bytes "${_hl} / 2")
    # 16 bytes a line keeps the generated file readable in a diff tool.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _arr "${_hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n" _arr "${_arr}")
    string(APPEND _out "const unsigned char ${_name}[] = {\n${_arr}\n};\n"
                       "const unsigned long ${_name}_len = ${_bytes};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${_out}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
