diff --git a/linux-stubs/windows-future/Cargo.toml b/linux-stubs/windows-future/Cargo.toml
new file mode 100644
index 0000000..6b80f3a
--- /dev/null
+++ b/linux-stubs/windows-future/Cargo.toml
@@ -0,0 +1,28 @@
+# An empty stand-in for windows-future 0.3.2 on Linux (the D3D11 build for
+# dxvk-native). The windows crate depends on windows-future for its WinRT
+# async types, which need COM marshalling and the Windows thread pool and do
+# not build off Windows; librashader uses none of them. Same name, version,
+# dependencies and features as the real crate, so Cargo.lock changes only in
+# where it comes from.
+[package]
+name = "windows-future"
+version = "0.3.2"
+edition = "2021"
+license = "MIT OR Apache-2.0"
+publish = false
+
+[dependencies.windows-core]
+version = "0.62.2"
+default-features = false
+
+[dependencies.windows-link]
+version = "0.2.1"
+default-features = false
+
+[dependencies.windows-threading]
+version = "0.2.1"
+default-features = false
+
+[features]
+default = ["std"]
+std = ["windows-core/std"]
